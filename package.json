{
  "name": "bb-plugin-pr-notes",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.94 <0.7.0"
  },
  "bb": {
    "name": "PR Notes",
    "description": "Review pull requests, keep private notes, and chat with agents in BB.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@pierre/diffs": "^1.2.9",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.48.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "prettier": "^3.9.10",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "Review pull requests, keep private notes, and chat with agents in BB.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "test:e2e": "playwright test",
    "format": "prettier --check \"*.ts\" \"*.tsx\" \"*.css\" \"e2e/*.ts\" \"scripts/*.mjs\"",
    "check": "npm run typecheck && npm run format && node scripts/release-notes.mjs --check && node scripts/verify-public-files.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "files": [
    "app.tsx",
    "server.ts",
    "github.ts",
    "filters.ts",
    "inbox-hooks.ts",
    "inbox-filters.tsx",
    "pr-ui.tsx",
    "pr-workspace.tsx",
    "notes-editor.tsx",
    "pr-chat.tsx",
    "code-diff.tsx",
    "app.css",
    "components",
    "lib",
    "skills",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "dist/server.js",
    "dist/server.meta.json",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "VERIFICATION.md",
    "pr-controls.tsx",
    "read-cache.ts",
    "view-cache.ts",
    "open-pr.tsx",
    "github-activity.ts",
    "github-checks.ts",
    "rich-markdown.tsx",
    "pr-activity.tsx",
    "pr-checks.tsx",
    "copy.ts",
    "assets",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "scripts",
    "docs",
    "tsconfig.json"
  ],
  "author": {
    "name": "Adebola",
    "url": "https://github.com/AdzeB"
  },
  "homepage": "https://github.com/AdzeB/bb-plugin-pr-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdzeB/bb-plugin-pr-notes.git"
  },
  "bugs": {
    "url": "https://github.com/AdzeB/bb-plugin-pr-notes/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "github",
    "pull-requests",
    "code-review",
    "notes",
    "agent-chat"
  ]
}
